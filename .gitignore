# ── macOS ───────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?

# ── Xcode: per-user state ───────────────────────────────────────────
# Window positions, breakpoints, the last-open file. Never useful to
# anyone else and a constant source of pointless diffs.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Keep xcshareddata/ — that is where shared schemes live. If you want
# `xcodebuild -scheme Sorae` to work for anyone who clones this, tick
# "Shared" on the scheme in Xcode > Product > Scheme > Manage Schemes.

# ── Xcode: build products ───────────────────────────────────────────
build/
DerivedData/
*.o
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.moved-aside

# ── Swift Package Manager ───────────────────────────────────────────
.build/
.swiftpm/
Packages/

# ── Playgrounds ─────────────────────────────────────────────────────
timeline.xctimeline
playground.xcworkspace

# ── Local secrets / signing ─────────────────────────────────────────
# Nothing here today. If a Config.xcconfig with a team ID or API key is
# ever added, ignore it and commit a Config.example.xcconfig instead.
*.mobileprovision
*.p12

# ── Launch video build (/brag) ──────────────────────────────────────
# Rendered frames, node_modules, copied system fonts and scratch audio.
# The finished film, poster and plan in brag-output/ are kept.
brag-output/work/

# ── Node (stray installs) ───────────────────────────────────────────
node_modules/

# ── Claude Code: per-user settings ──────────────────────────────────
.claude/settings.local.json
